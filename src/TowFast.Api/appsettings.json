{
  "ConnectionStrings": {
    "TowFast": "Host=localhost;Port=5432;Database=towfast;Username=postgres"
  },
  "Jwt": {
    "Issuer": "TowFast",
    "Audience": "TowFast.Clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Swagger": { "Enabled": false },
  "Database": { "AutoMigrate": false },
  "Tracking": {
    "PublishIntervalSeconds": 10,
    "QueryIntervalSeconds": 10,
    "StaleAfterSeconds": 30,
    "MaxSampleAgeSeconds": 3600,
    "FutureToleranceSeconds": 60
  },
  "Pagination": { "MaxPageSize": 100 },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
