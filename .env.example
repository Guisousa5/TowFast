# Backend (.NET environment variables)
ConnectionStrings__TowFast=Host=DB_HOST;Port=5432;Database=postgres;Username=DB_USER;Password=DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
Jwt__SigningKey=SET_A_RANDOM_SECRET_WITH_AT_LEAST_32_BYTES
Database__AutoMigrate=false
BootstrapAdmin__Email=
BootstrapAdmin__Password=
Swagger__Enabled=false

# Frontend values injected into web/towfast-web/public/config.json at deploy time
API_BASE_URL=https://api.example.com
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
TRACKING_INTERVAL_MS=10000
